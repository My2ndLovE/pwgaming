# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# Required variables are marked with (REQUIRED)
# ============================================

# Environment
NODE_ENV=development  # Options: development, production, test

# Server
PORT=4110  # Must be between 1024-65535

# ============================================
# DATABASE (PostgreSQL) - REQUIRED
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username  # (REQUIRED)
DB_PASSWORD=your_db_password  # (REQUIRED)
DB_DATABASE=poker_platform    # (REQUIRED)
DB_DATABASE_TEST=poker_platform_test

# Alternative database env vars (Azure/Docker compatibility)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=your_db_username
# DATABASE_PASSWORD=your_db_password
# DATABASE_NAME=poker_platform

# ============================================
# REDIS - REQUIRED
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0           # 0-15
REDIS_PASSWORD=      # Optional for local, required for production
# REDIS_URL=redis://localhost:6379  # Alternative: full connection string

# ============================================
# SECURITY - REQUIRED
# ============================================
# IMPORTANT: Generate a strong secret (minimum 32 characters)
# Example: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_EXPIRATION=7d

# ============================================
# TELEGRAM - REQUIRED
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here  # (REQUIRED)

# ============================================
# FRONTEND & CORS - REQUIRED FOR PRODUCTION
# ============================================
# CRITICAL: FRONTEND_URL must be set in production
# Production will fail to start without this value
# Do NOT use localhost in production
FRONTEND_URL=http://localhost:4120  # Development
# Production example: FRONTEND_URL=https://poker.pwgaming.com
ALLOWED_ORIGINS=http://localhost:4120,http://localhost:3000

# ============================================
# WALLET CONFIGURATION
# ============================================
WALLET_MODE=manual  # Options: manual, auto

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60000   # Time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_MAX=100     # Max requests per time window (default: 100)

# ============================================
# MONITORING (Optional)
# ============================================
# Sentry error tracking (production recommended)
SENTRY_DSN=

# Azure Application Insights (production only)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ============================================
# PAYMENT GATEWAY (Future Implementation)
# ============================================
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_API_SECRET=
